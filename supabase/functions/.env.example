# Edge Function secrets (set via `supabase secrets set`):
# APOLLO_API_KEY=       # optional Apollo people/match email enrichment
# TOMBA_API_KEY=        # optional Tomba.io — API key (X-Tomba-Key). Requires secret too.
# TOMBA_SECRET=         # optional Tomba.io — secret (X-Tomba-Secret). TOMBA_API_SECRET also works.
# HUNTER_API_KEY=
# OPENAI_API_KEY=
# BING_SEARCH_API_KEY=   # free Azure Bing Search — LinkedIn URL discovery
# SERPER_API_KEY=        # optional paid Google SERP alternative
# PROXYCURL_API_KEY=     # disabled — no longer used
# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# APP_ORIGIN=https://crazykalo27.github.io/FollowUp
# Optional OSINT worker (Google Cloud Run) — tools/email-discovery/deploy/cloud-run.md
# npx supabase secrets set OSINT_WORKER_URL=https://….run.app
# npx supabase secrets set OSINT_WORKER_SECRET=
# npx supabase functions deploy run-search --project-ref czakwfzjkhsaysvqeswc
